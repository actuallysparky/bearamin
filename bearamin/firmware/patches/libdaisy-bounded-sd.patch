diff --git a/tests/SdDiskio_gtest.cpp b/tests/SdDiskio_gtest.cpp
new file mode 100644
index 00000000..733ccd3b
--- /dev/null
+++ b/tests/SdDiskio_gtest.cpp
@@ -0,0 +1,67 @@
+#include <gtest/gtest.h>
+
+#include <fstream>
+#include <sstream>
+#include <string>
+
+namespace
+{
+std::string ReadFile(const std::string& path)
+{
+    std::ifstream input(path.c_str());
+    EXPECT_TRUE(input.good()) << path;
+    std::ostringstream buffer;
+    buffer << input.rdbuf();
+    return buffer.str();
+}
+
+std::string RepoRoot()
+{
+    std::string file = __FILE__;
+    const std::string suffix = "/tests/SdDiskio_gtest.cpp";
+    const std::string::size_type pos = file.rfind(suffix);
+    EXPECT_NE(pos, std::string::npos);
+    return file.substr(0, pos);
+}
+
+int CountOccurrences(const std::string& text, const std::string& needle)
+{
+    int count = 0;
+    std::string::size_type pos = 0;
+    while((pos = text.find(needle, pos)) != std::string::npos)
+    {
+        ++count;
+        pos += needle.size();
+    }
+    return count;
+}
+} // namespace
+
+TEST(SdDiskio, TimeoutApiMatchesDocumentedContract)
+{
+    const std::string root   = RepoRoot();
+    const std::string header = ReadFile(root + "/src/util/sd_diskio.h");
+    const std::string source = ReadFile(root + "/src/util/sd_diskio.c");
+
+    EXPECT_NE(header.find("Set the maximum time, in milliseconds"), std::string::npos);
+    EXPECT_NE(header.find("The default remains 30000 ms"), std::string::npos);
+    EXPECT_NE(header.find("void SD_SetIoTimeout(uint32_t timeout_ms);"), std::string::npos);
+    EXPECT_NE(header.find("uint32_t SD_GetIoTimeout(void);"), std::string::npos);
+
+    EXPECT_NE(source.find("#define SD_DEFAULT_TIMEOUT_MS (30U * 1000U)"), std::string::npos);
+    EXPECT_NE(source.find("static uint32_t sd_io_timeout_ms = SD_DEFAULT_TIMEOUT_MS;"), std::string::npos);
+    EXPECT_NE(source.find("sd_io_timeout_ms = timeout_ms > 0 ? timeout_ms : 1;"), std::string::npos);
+    EXPECT_NE(source.find("return sd_io_timeout_ms;"), std::string::npos);
+}
+
+TEST(SdDiskio, ReadAndWriteWaitsUseConfiguredTimeout)
+{
+    const std::string source = ReadFile(RepoRoot() + "/src/util/sd_diskio.c");
+
+    EXPECT_EQ(source.find("SD_TIMEOUT"), std::string::npos);
+    EXPECT_EQ(5, CountOccurrences(source, "< sd_io_timeout_ms"));
+    EXPECT_NE(
+        source.find("BSP_SD_WriteBlocks(\n"
+                    "           (uint32_t *)buff, (uint32_t)(sector), count, sd_io_timeout_ms)"),
+        std::string::npos);
+}
